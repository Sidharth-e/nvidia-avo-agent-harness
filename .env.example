NEO4J_USER=neo4j
NEO4J_PASS=your_strong_password_here
NEO4J_URI=bolt://localhost:7687

# Mode: "local" or "cloud"
OLLAMA_MODE=local

# Local configuration (used when OLLAMA_MODE=local)
OLLAMA_LOCAL_MODEL=gemma4:e2b-mlx
OLLAMA_LOCAL_BASE_URL=http://localhost:11434

# Cloud configuration (used when OLLAMA_MODE=cloud)
OLLAMA_CLOUD_MODEL=llama3.3
OLLAMA_CLOUD_BASE_URL=https://api.ollama.com
OLLAMA_API_KEY=
